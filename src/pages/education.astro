---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Tag from "@/components/Tag.astro";

const education = (await getCollection("education")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Education" description="Academic background, degrees, and research/thesis work.">
  <Section eyebrow="Education" title="Academic Background">
    {education.length === 0 ? (
      <p class="text-[var(--color-text-muted)]">
        No education entries published yet — check back soon.
      </p>
    ) : (
      <div class="space-y-6">
        {education.map((edu) => {
          const { degree, university, department, startYear, endYear, cgpa, relevantCoursework, thesis, achievements } = edu.data;
          return (
            <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="text-lg font-semibold text-[var(--color-text)]">{degree}</h3>
                <span class="font-mono text-xs text-[var(--color-text-muted)]">{startYear} — {endYear || "Present"}</span>
              </div>
              <p class="text-[var(--color-text-muted)]">{university}{department ? ` · ${department}` : ""}</p>
              {cgpa && <p class="mt-1 text-sm text-[var(--color-text-muted)]">CGPA: {cgpa}</p>}
              {thesis && <p class="mt-3 text-sm text-[var(--color-text-muted)]"><span class="font-semibold text-[var(--color-text)]">Thesis: </span>{thesis}</p>}
              {relevantCoursework.length > 0 && (
                <div class="mt-3">
                  <p class="text-xs font-semibold uppercase tracking-wide text-[var(--color-text)]">Relevant coursework</p>
                  <div class="mt-1.5 flex flex-wrap gap-1.5">{relevantCoursework.map((c) => <Tag label={c} />)}</div>
                </div>
              )}
              {achievements.length > 0 && (
                <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-[var(--color-text-muted)]">
                  {achievements.map((a) => <li>{a}</li>)}
                </ul>
              )}
            </div>
          );
        })}
      </div>
    )}
  </Section>
</BaseLayout>
