---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
---

<BaseLayout title="Page Not Found" description="Page not found." noindex>
  <div class="mx-auto flex max-w-6xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <p class="font-mono text-sm text-[var(--color-accent)]">404</p>
    <h1 class="mt-2 text-3xl font-bold text-[var(--color-text)]">Page not found</h1>
    <p class="mt-3 max-w-md text-[var(--color-text-muted)]">
      The page you're looking for doesn't exist or may have moved.
    </p>
    <div class="mt-6"><Button href="/">Back to home</Button></div>
  </div>
</BaseLayout>
