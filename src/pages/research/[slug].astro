---
import { getCollection, render, getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Tag from "@/components/Tag.astro";

export async function getStaticPaths() {
  const topics = await getCollection("research", ({ data }) => !data.draft);
  return topics.map((topic) => ({
    params: { slug: topic.id },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const { Content } = await render(topic);
const {
  title, summary, description, motivation, researchQuestions, technologies,
  relatedProjects, relatedPublications, status, futureDirection, tags,
} = topic.data;

const relatedProjectEntries = await Promise.all(
  relatedProjects.map((slug) => getEntry("projects", slug))
);
const relatedPublicationEntries = await Promise.all(
  relatedPublications.map((slug) => getEntry("publications", slug))
);
---

<BaseLayout title={title} description={summary}>
  <Section>
    <a href="/research" class="text-sm text-[var(--color-accent)] hover:underline">← All research interests</a>

    <div class="mt-4 flex flex-wrap items-center gap-2">
      <span class="rounded-full border border-[var(--color-border)] px-2 py-0.5 text-xs uppercase tracking-wide text-[var(--color-text-muted)]">
        {status}
      </span>
      {tags.map((t) => <Tag label={t} />)}
    </div>

    <h1 class="mt-4 text-3xl font-bold tracking-tight text-[var(--color-text)] sm:text-4xl">{title}</h1>
    <p class="mt-3 max-w-2xl text-lg text-[var(--color-text-muted)]">{summary}</p>

    <div class="mt-10 grid gap-10 lg:grid-cols-3">
      <div class="prose lg:col-span-2">
        {description && (
          <>
            <h2>Overview</h2>
            <p>{description}</p>
          </>
        )}
        {motivation && (
          <>
            <h2>Motivation</h2>
            <p>{motivation}</p>
          </>
        )}
        {researchQuestions.length > 0 && (
          <>
            <h2>Research Questions</h2>
            <ul>{researchQuestions.map((q) => <li>{q}</li>)}</ul>
          </>
        )}
        <Content />
        {futureDirection && (
          <>
            <h2>Future Direction</h2>
            <p>{futureDirection}</p>
          </>
        )}
      </div>

      <aside class="space-y-4">
        {technologies.length > 0 && (
          <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-5">
            <p class="font-mono text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">Technologies</p>
            <div class="mt-2 flex flex-wrap gap-1.5">{technologies.map((t) => <Tag label={t} />)}</div>
          </div>
        )}
        {relatedProjectEntries.filter(Boolean).length > 0 && (
          <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-5">
            <p class="font-mono text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">Related Projects</p>
            <ul class="mt-2 space-y-1 text-sm">
              {relatedProjectEntries.filter(Boolean).map((p) => (
                <li><a href={`/projects/${p!.id}`} class="text-[var(--color-accent)] hover:underline">{p!.data.title}</a></li>
              ))}
            </ul>
          </div>
        )}
        {relatedPublicationEntries.filter(Boolean).length > 0 && (
          <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-5">
            <p class="font-mono text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">Related Publications</p>
            <ul class="mt-2 space-y-1 text-sm">
              {relatedPublicationEntries.filter(Boolean).map((p) => (
                <li><a href={`/publications/${p!.id}`} class="text-[var(--color-accent)] hover:underline">{p!.data.title}</a></li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </Section>
</BaseLayout>
