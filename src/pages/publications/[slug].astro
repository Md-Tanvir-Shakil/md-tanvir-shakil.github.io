---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Tag from "@/components/Tag.astro";
import Button from "@/components/Button.astro";

export async function getStaticPaths() {
  const publications = await getCollection("publications", ({ data }) => !data.draft);
  return publications.map((pub) => ({
    params: { slug: pub.id },
    props: { pub },
  }));
}

const { pub } = Astro.props;
const { Content } = await render(pub);
const { title, authors, year, venue, type, doi, url, pdfUrl, abstract, keywords, citation, status } = pub.data;
---

<BaseLayout
  title={title}
  description={abstract ?? `${title} — ${authors.join(", ")}`}
  type="article"
  scholarly={{ authors, venue, doi }}
>
  <Section>
    <a href="/publications" class="text-sm text-[var(--color-accent)] hover:underline">← All publications</a>

    <div class="mt-4 flex flex-wrap items-center gap-2">
      <span class="rounded-full border border-[var(--color-border)] px-2 py-0.5 text-xs uppercase tracking-wide text-[var(--color-text-muted)]">
        {type.replace("-", " ")}
      </span>
      <span class="rounded-full border border-[var(--color-border)] px-2 py-0.5 text-xs uppercase tracking-wide text-[var(--color-text-muted)]">
        {status.replace("-", " ")}
      </span>
      {year && <span class="font-mono text-sm text-[var(--color-text-muted)]">{year}</span>}
    </div>

    <h1 class="mt-4 text-3xl font-bold tracking-tight text-[var(--color-text)] sm:text-4xl">{title}</h1>
    <p class="mt-2 text-[var(--color-text-muted)]">{authors.join(", ")}</p>
    {venue && <p class="mt-1 italic text-[var(--color-text-muted)]">{venue}</p>}

    <div class="mt-6 flex flex-wrap gap-3">
      {url && <Button href={url} variant="primary" external>View Publication</Button>}
      {pdfUrl && <Button href={pdfUrl} variant="secondary" external>PDF</Button>}
      {doi && <Button href={`https://doi.org/${doi}`} variant="ghost" external>DOI: {doi}</Button>}
    </div>

    <div class="prose mt-10">
      {abstract && (<><h2>Abstract</h2><p>{abstract}</p></>)}
      <Content />
      {citation && (
        <>
          <h2>Citation</h2>
          <pre><code>{citation}</code></pre>
        </>
      )}
    </div>

    {keywords.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-1.5">{keywords.map((k) => <Tag label={k} />)}</div>
    )}
  </Section>
</BaseLayout>
