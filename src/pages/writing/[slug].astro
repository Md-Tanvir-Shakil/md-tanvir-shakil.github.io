---
import { getCollection, render, getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Tag from "@/components/Tag.astro";
import { readingTime } from "@/utils/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, updatedDate, author, summary, tags, category, coverImage, relatedProjects, relatedResearch } = post.data;

const relatedProjectEntries = await Promise.all(relatedProjects.map((slug) => getEntry("projects", slug)));
const relatedResearchEntries = await Promise.all(relatedResearch.map((slug) => getEntry("research", slug)));
---

<BaseLayout title={title} description={summary} type="article" publishDate={date} updatedDate={updatedDate}>
  <Section>
    <a href="/writing" class="text-sm text-[var(--color-accent)] hover:underline">← All writing</a>

    <div class="mt-4 flex flex-wrap items-center gap-2 font-mono text-xs text-[var(--color-text-muted)]">
      <span>{date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</span>
      <span>·</span>
      <span>{readingTime(post.body ?? "")}</span>
      <span>·</span>
      <span>{author}</span>
      {category && (<><span>·</span><span>{category}</span></>)}
    </div>

    <h1 class="mt-3 text-3xl font-bold tracking-tight text-[var(--color-text)] sm:text-4xl">{title}</h1>
    <p class="mt-3 max-w-2xl text-lg text-[var(--color-text-muted)]">{summary}</p>

    {tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">{tags.map((t) => <Tag label={t} />)}</div>
    )}

    {coverImage && (
      <div class="mt-8 w-full overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)]">
        <img src={coverImage} alt={title} class="w-full object-cover" />
      </div>
    )}

    <div class="prose mt-10">
      <Content />
    </div>

    {(relatedProjectEntries.filter(Boolean).length > 0 || relatedResearchEntries.filter(Boolean).length > 0) && (
      <div class="mt-12 grid gap-4 border-t border-[var(--color-border)] pt-8 sm:grid-cols-2">
        {relatedProjectEntries.filter(Boolean).length > 0 && (
          <div>
            <p class="font-mono text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">Related Projects</p>
            <ul class="mt-2 space-y-1 text-sm">
              {relatedProjectEntries.filter(Boolean).map((p) => (
                <li><a href={`/projects/${p!.id}`} class="text-[var(--color-accent)] hover:underline">{p!.data.title}</a></li>
              ))}
            </ul>
          </div>
        )}
        {relatedResearchEntries.filter(Boolean).length > 0 && (
          <div>
            <p class="font-mono text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">Related Research</p>
            <ul class="mt-2 space-y-1 text-sm">
              {relatedResearchEntries.filter(Boolean).map((r) => (
                <li><a href={`/research/${r!.id}`} class="text-[var(--color-accent)] hover:underline">{r!.data.title}</a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
  </Section>
</BaseLayout>
