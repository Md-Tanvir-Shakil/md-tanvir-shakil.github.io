---
import type { CollectionEntry } from "astro:content";
import Tag from "@/components/Tag.astro";
import { formatDateRange } from "@/utils/site";

interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const { title, summary, technologies, categories, status, startDate, endDate, type } = project.data;
---

<a
  href={`/projects/${project.id}`}
  class="group flex h-full flex-col rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-5 transition-colors hover:border-[var(--color-accent)]"
>
  <div class="mb-2 flex items-center justify-between gap-2">
    <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--color-text-muted)]">
      {type === "research" ? "Research Project" : "Engineering Project"}
    </span>
    <span class="rounded-full border border-[var(--color-border)] px-2 py-0.5 text-[10px] uppercase tracking-wide text-[var(--color-text-muted)]">
      {status}
    </span>
  </div>

  <h3 class="text-lg font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent)]">
    {title}
  </h3>

  {(startDate || endDate) && (
    <p class="mt-1 font-mono text-xs text-[var(--color-text-muted)]">{formatDateRange(startDate, endDate)}</p>
  )}

  <p class="mt-3 flex-1 text-sm text-[var(--color-text-muted)]">{summary}</p>

  {categories.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-1.5">
      {categories.slice(0, 3).map((c) => <Tag label={c} />)}
    </div>
  )}

  {technologies.length > 0 && (
    <p class="mt-3 truncate font-mono text-xs text-[var(--color-text-muted)]">
      {technologies.slice(0, 5).join(" · ")}
    </p>
  )}
</a>
