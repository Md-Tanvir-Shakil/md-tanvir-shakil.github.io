---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { profile } from "@/utils/site";

const navItems = [
  { href: "/about", label: "About" },
  { href: "/research", label: "Research" },
  { href: "/projects", label: "Projects" },
  { href: "/publications", label: "Publications" },
  { href: "/experience", label: "Experience" },
  { href: "/writing", label: "Writing" },
  { href: "/cv", label: "CV" },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]/90 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6" aria-label="Primary">
    <a href="/" class="shrink-0 font-mono text-sm font-semibold tracking-tight text-[var(--color-text)]">
      {profile.name}
    </a>

    <button
      id="nav-toggle"
      type="button"
      class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-[var(--color-border)] text-[var(--color-text)] md:hidden"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <div id="nav-menu" class="hidden w-full flex-col gap-1 md:flex md:w-auto md:flex-row md:items-center md:gap-1">
      {navItems.map((item) => {
        const active = currentPath === item.href || currentPath.startsWith(item.href + "/");
        return (
          <a
            href={item.href}
            class:list={[
              "rounded-md px-3 py-2 text-sm font-medium transition-colors",
              active
                ? "text-[var(--color-accent)]"
                : "text-[var(--color-text-muted)] hover:text-[var(--color-text)]",
            ]}
            aria-current={active ? "page" : undefined}
          >
            {item.label}
          </a>
        );
      })}
      <a
        href="/contact"
        class="mt-2 rounded-md bg-[var(--color-accent)] px-3 py-2 text-center text-sm font-medium text-white transition-opacity hover:opacity-90 md:ml-2 md:mt-0"
      >
        Let's Connect
      </a>
      <div class="mt-2 flex justify-center md:ml-2 md:mt-0">
        <ThemeToggle />
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    const toggle = document.getElementById("nav-toggle");
    const menu = document.getElementById("nav-menu");
    toggle?.addEventListener("click", () => {
      const isHidden = menu?.classList.contains("hidden");
      menu?.classList.toggle("hidden");
      menu?.classList.toggle("flex");
      toggle.setAttribute("aria-expanded", String(!!isHidden));
    });
  })();
</script>
