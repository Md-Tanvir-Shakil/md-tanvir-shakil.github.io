---
import type { CollectionEntry } from "astro:content";
import Tag from "@/components/Tag.astro";
import { formatDateRange } from "@/utils/site";

interface Props {
  items: CollectionEntry<"experience">[];
}
const { items } = Astro.props;
---

<ol class="relative border-l border-[var(--color-border)] pl-6">
  {items.map((item) => {
    const { company, companyUrl, position, location, startDate, endDate, description, responsibilities, achievements, technologies } = item.data;
    return (
      <li class="mb-12 last:mb-0">
        <span class="absolute -left-[7px] mt-1.5 h-3 w-3 rounded-full border-2 border-[var(--color-bg)] bg-[var(--color-accent)]"></span>

        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="text-lg font-semibold text-[var(--color-text)]">
            {position} ·{" "}
            {companyUrl ? (
              <a href={companyUrl} target="_blank" rel="noopener noreferrer" class="underline decoration-[var(--color-border)] underline-offset-2 hover:decoration-[var(--color-accent)]">
                {company}
              </a>
            ) : (
              company
            )}
          </h3>
          <span class="font-mono text-xs text-[var(--color-text-muted)]">{formatDateRange(startDate, endDate)}</span>
        </div>
        {location && <p class="text-sm text-[var(--color-text-muted)]">{location}</p>}

        {description && <p class="mt-2 text-sm text-[var(--color-text-muted)]">{description}</p>}

        {achievements.length > 0 && (
          <div class="mt-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-[var(--color-text)]">What I built / impact</p>
            <ul class="mt-1.5 list-disc space-y-1 pl-5 text-sm text-[var(--color-text-muted)]">
              {achievements.map((a) => <li>{a}</li>)}
            </ul>
          </div>
        )}

        {responsibilities.length > 0 && (
          <div class="mt-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-[var(--color-text)]">Responsibilities</p>
            <ul class="mt-1.5 list-disc space-y-1 pl-5 text-sm text-[var(--color-text-muted)]">
              {responsibilities.map((r) => <li>{r}</li>)}
            </ul>
          </div>
        )}

        {technologies.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-1.5">
            {technologies.map((t) => <Tag label={t} />)}
          </div>
        )}
      </li>
    );
  })}
</ol>
