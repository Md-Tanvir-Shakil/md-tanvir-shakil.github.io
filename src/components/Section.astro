---
interface Props {
  title?: string;
  eyebrow?: string;
  description?: string;
  id?: string;
  class?: string;
}
const { title, eyebrow, description, id, class: className = "" } = Astro.props;
---

<section id={id} class:list={["mx-auto max-w-6xl px-4 py-14 sm:px-6", className]}>
  {(title || eyebrow) && (
    <div class="mb-8 max-w-2xl">
      {eyebrow && (
        <p class="mb-2 font-mono text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">
          {eyebrow}
        </p>
      )}
      {title && <h2 class="text-2xl font-semibold tracking-tight text-[var(--color-text)] sm:text-3xl">{title}</h2>}
      {description && <p class="mt-3 text-[var(--color-text-muted)]">{description}</p>}
    </div>
  )}
  <slot />
</section>
