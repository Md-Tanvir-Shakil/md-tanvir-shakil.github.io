---
import { profile, site } from "@/utils/site";

const year = new Date().getFullYear();

const socialLinks = [
  { key: "github", label: "GitHub" },
  { key: "linkedin", label: "LinkedIn" },
  { key: "googleScholar", label: "Google Scholar" },
  { key: "orcid", label: "ORCID" },
  { key: "researchGate", label: "ResearchGate" },
] as const;

const social: Record<string, string> = profile.social;

const visibleSocial = socialLinks.filter((s) => {
  const v = social[s.key];
  return v && v.length > 0 && !v.startsWith("[ADD");
});
---

<footer class="border-t border-[var(--color-border)]">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="font-mono text-sm font-semibold text-[var(--color-text)]">{profile.name}</p>
        <p class="mt-1 max-w-sm text-sm text-[var(--color-text-muted)]">{profile.title}</p>
      </div>

      <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {visibleSocial.map((s) => (
          <a
            href={social[s.key]}
            target="_blank"
            rel="noopener noreferrer me"
            class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)]"
          >
            {s.label}
          </a>
        ))}
        <a href="/contact" class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)]">Contact</a>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-2 border-t border-[var(--color-border)] pt-6 text-xs text-[var(--color-text-muted)] sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {profile.name}. Built with Astro, hosted on GitHub Pages.</p>
      <a
        href={`https://github.com/${site.githubUsername}`}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-[var(--color-accent)]"
      >
        View source on GitHub
      </a>
    </div>
  </div>
</footer>
