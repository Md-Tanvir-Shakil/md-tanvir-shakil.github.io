---
import type { CollectionEntry } from "astro:content";
import Tag from "@/components/Tag.astro";

interface Props {
  topic: CollectionEntry<"research">;
}
const { topic } = Astro.props;
const { title, summary, technologies, status, tags } = topic.data;
---

<a
  href={`/research/${topic.id}`}
  class="group flex h-full flex-col rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-5 transition-colors hover:border-[var(--color-accent)]"
>
  <div class="mb-2 flex items-center justify-between gap-2">
    <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--color-text-muted)]">
      Research Interest
    </span>
    <span class="rounded-full border border-[var(--color-border)] px-2 py-0.5 text-[10px] uppercase tracking-wide text-[var(--color-text-muted)]">
      {status}
    </span>
  </div>

  <h3 class="text-lg font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent)]">
    {title}
  </h3>

  <p class="mt-3 flex-1 text-sm text-[var(--color-text-muted)]">{summary}</p>

  {(tags.length > 0 || technologies.length > 0) && (
    <div class="mt-4 flex flex-wrap gap-1.5">
      {(tags.length > 0 ? tags : technologies).slice(0, 4).map((t) => <Tag label={t} />)}
    </div>
  )}
</a>
