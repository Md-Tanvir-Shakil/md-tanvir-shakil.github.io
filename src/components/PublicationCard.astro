---
import type { CollectionEntry } from "astro:content";
import Tag from "@/components/Tag.astro";

interface Props {
  publication: CollectionEntry<"publications">;
}
const { publication } = Astro.props;
const { title, authors, year, venue, type, status, keywords } = publication.data;
---

<article class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-5">
  <div class="mb-2 flex flex-wrap items-center gap-2">
    <span class="rounded-full border border-[var(--color-border)] px-2 py-0.5 font-mono text-[10px] uppercase tracking-wide text-[var(--color-text-muted)]">
      {type.replace("-", " ")}
    </span>
    <span class="rounded-full border border-[var(--color-border)] px-2 py-0.5 font-mono text-[10px] uppercase tracking-wide text-[var(--color-text-muted)]">
      {status.replace("-", " ")}
    </span>
    {year && <span class="font-mono text-xs text-[var(--color-text-muted)]">{year}</span>}
  </div>

  <h3 class="text-lg font-semibold text-[var(--color-text)]">
    <a href={`/publications/${publication.id}`} class="hover:text-[var(--color-accent)]">{title}</a>
  </h3>

  <p class="mt-1 text-sm text-[var(--color-text-muted)]">{authors.join(", ")}</p>
  {venue && <p class="mt-0.5 text-sm italic text-[var(--color-text-muted)]">{venue}</p>}

  {keywords.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-1.5">
      {keywords.slice(0, 5).map((k) => <Tag label={k} />)}
    </div>
  )}

  <div class="mt-4">
    <a href={`/publications/${publication.id}`} class="text-sm font-medium text-[var(--color-accent)] hover:underline">
      View details →
    </a>
  </div>
</article>
