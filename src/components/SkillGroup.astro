---
import Tag from "@/components/Tag.astro";

interface Props {
  category: string;
  items: string[];
}
const { category, items } = Astro.props;
---

<div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-5">
  <h3 class="mb-3 font-mono text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">
    {category}
  </h3>
  <div class="flex flex-wrap gap-1.5">
    {items.map((item) => <Tag label={item} />)}
  </div>
</div>
